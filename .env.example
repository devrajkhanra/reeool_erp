# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign and verify JWTs. Required — the app will refuse to
# start without it. Generate a strong random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"

# How long issued JWTs stay valid.
JWT_EXPIRES_IN="1d"
